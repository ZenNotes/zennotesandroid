<?xml version="1.0" encoding="utf-8"?>
<!-- Recent Notes (4x2 and up): header with the vault name and a + button,
     then a scrolling list fed by RecentNotesWidgetService. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UseAppTint"
    android:id="@+id/zn_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/zn_widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/zn_widget_bg"
        android:tint="@color/znWidgetBg"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:id="@+id/zn_header"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/zn_header_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/zn_enso"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/zn_header_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/widget_app_name"
                android:textColor="@color/znWidgetMuted"
                android:textSize="12sp" />

            <FrameLayout
                android:id="@+id/zn_header_action"
                android:layout_width="24dp"
                android:layout_height="24dp">

                <ImageView
                    android:id="@+id/zn_header_action_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/zn_circle"
                    android:tint="#2EE78A4E"
                    android:importantForAccessibility="no" />

                <ImageView
                    android:id="@+id/zn_header_action_icon"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_zn_plus"
                    android:tint="@color/znWidgetAccent"
                    android:contentDescription="@string/widget_new_note_title" />
            </FrameLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ListView
                android:id="@+id/zn_widget_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:scrollbars="none" />

            <LinearLayout
                android:id="@+id/zn_widget_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/zn_empty_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/widget_empty_no_notes"
                    android:textColor="@color/znWidgetFg"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/zn_empty_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/widget_empty_no_notes_detail"
                    android:textColor="@color/znWidgetMuted"
                    android:textSize="12sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
