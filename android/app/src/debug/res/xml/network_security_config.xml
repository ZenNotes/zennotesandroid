<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Debug mirrors the release manifest's usesCleartextTraffic="true"
         (self-hosted servers on plain-HTTP LAN hosts are a supported flow);
         a domain-config-only file would silently re-block everything else,
         because a networkSecurityConfig overrides the manifest flag. -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
